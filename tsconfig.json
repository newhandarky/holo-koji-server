{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": [
    "index.ts",
    "http/**/*.ts",
    "rooms/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}

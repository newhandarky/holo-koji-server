{
  "name": "holokoji-server",
  "version": "0.2.0",
  "description": "HOLO小路線上對戰遊戲後端伺服器",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/utils/*.test.js",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "dev:watch": "nodemon --watch . --ext ts --exec \"npm run dev\""
  },
  "keywords": [
    "websocket",
    "game",
    "hanamikoji"
  ],
  "author": "Atsushi",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "@newhandarky/hanakoji-game-types": "1.1.0",
    "redis": "^4.7.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
